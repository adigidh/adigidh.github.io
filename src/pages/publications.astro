---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FilterBar from '../components/FilterBar.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('publications');

const groups = [
  {
    label: 'Peer-Reviewed Research',
    description: 'Conference papers and proceedings with formal review',
    items: all.filter(p => ['conference', 'journal'].includes(p.data.type)).sort((a, b) => b.data.year - a.data.year),
  },
  {
    label: 'White Papers & Industry Reports',
    description: 'Technical reports and architecture documentation',
    items: all.filter(p => p.data.type === 'whitepaper').sort((a, b) => b.data.year - a.data.year),
  },
  {
    label: 'Technical Writing - IBM Developer',
    description: 'Articles and tutorials published on IBM Developer',
    items: all.filter(p => ['article', 'tutorial'].includes(p.data.type)).sort((a, b) => b.data.year - a.data.year),
  },
];

const typeBadge: Record<string, string> = {
  conference: 'badge-green',
  journal: 'badge-purple',
  whitepaper: 'badge-blue',
  article: 'badge-amber',
  tutorial: 'badge-teal',
};

const types = [...new Set(all.map((p) => p.data.type))];
---

<BaseLayout title="Publications - Aditya Gidh">
  <div class="wrap-narrow pb-8">
    <PageHeader
      eyebrow="Publications"
      title="Research & writing"
      lead="Peer-reviewed research, white papers, and technical writing spanning AI engineering, knowledge graphs, and applied machine learning."
    />

    <div data-filter-root>
      {types.length > 1 && <FilterBar label="Filter by type" options={types} />}

      <div class="space-y-14">
        {groups.filter(g => g.items.length > 0).map((group) => (
          <section data-filter-section>
            <div class="mb-6 pb-3 border-b border-line">
              <h2 class="font-serif text-2xl tracking-tight">{group.label}</h2>
              <p class="text-sm text-muted mt-1">{group.description}</p>
            </div>

            <ul class="space-y-6">
              {group.items.map((pub) => (
                <li data-filter-item data-tags={pub.data.type} class="reveal flex gap-5">
                  <span class="w-10 shrink-0 pt-0.5 font-mono text-xs text-muted">{pub.data.year}</span>
                  <article class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-2 mb-1.5">
                      <span class:list={['badge', typeBadge[pub.data.type]]}>{pub.data.type}</span>
                      <span class="text-xs text-muted">{pub.data.venue}</span>
                    </div>
                    {pub.data.url ? (
                      <a href={pub.data.url} target="_blank" rel="noopener noreferrer" class="group">
                        <h3 class="font-medium group-hover:text-accent transition-colors">
                          {pub.data.title}
                          <svg class="inline w-3.5 h-3.5 ml-1 mb-0.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                          <span class="sr-only">(opens in a new tab)</span>
                        </h3>
                      </a>
                    ) : (
                      <h3 class="font-medium">{pub.data.title}</h3>
                    )}
                    <p class="mt-1 text-sm text-muted leading-relaxed max-w-[54ch]">{pub.data.description}</p>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
