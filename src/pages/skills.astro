---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const skillCategories = [
  {
    name: 'AI & LLM Engineering',
    skills: ['LangChain', 'LangFlow', 'LangGraph', 'RAG Pipelines', 'Vector Databases (FAISS, ChromaDB)', 'Ollama', 'Prompt Engineering', 'IBM Granite', 'OpenAI', 'Gemini', 'JSON Prompting', 'AI-Powered CLI Tools'],
  },
  {
    name: 'Web Development',
    skills: ['HTML5', 'CSS3', 'JavaScript (ES6+)', 'TypeScript', 'React.js', 'Angular', 'Node.js', 'Next.js', 'Astro'],
  },
  {
    name: 'DevOps & Cloud',
    skills: ['Docker', 'Kubernetes', 'OpenShift', 'Helm', 'Tekton', 'Jenkins', 'Travis CI', 'IBM Cloud', 'Git', 'JFrog Artifactory', 'Blue-Green Deployments'],
  },
  {
    name: 'Monitoring & Observability',
    skills: ['Prometheus', 'Grafana', 'ELK Stack', 'OpenTelemetry', 'New Relic', 'PagerDuty', 'Zabbix'],
  },
  {
    name: 'Backend & Databases',
    skills: ['PostgreSQL', 'MongoDB', 'MySQL', 'Elasticsearch', 'PL/SQL', 'CouchDB', 'Redis'],
  },
  {
    name: 'Languages',
    skills: ['Python', 'JavaScript/TypeScript', 'R', 'Java', 'Objective-C', 'Groovy'],
  },
];
---

<BaseLayout title="Skills - Aditya Gidh">
  <div class="wrap pb-8">
    <PageHeader
      eyebrow="Skills"
      title="Skills & competencies"
      lead="Technical expertise spanning the full stack - from AI/ML pipelines to production infrastructure."
    />

    <div class="grid md:grid-cols-2 gap-5">
      {skillCategories.map((category, i) => (
        <section class="reveal card p-6" style={`--reveal-delay:${(i % 2) * 70}ms`}>
          <p class="eyebrow text-accent mb-2">0{i + 1}</p>
          <h2 class="font-serif text-xl tracking-tight mb-4">{category.name}</h2>
          <ul class="flex flex-wrap gap-1.5">
            {category.skills.map((skill) => (
              <li class="chip">{skill}</li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
