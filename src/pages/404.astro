---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navLinks } from '../data/site';
---

<BaseLayout title="Not found - Aditya Gidh">
  <section class="wrap-narrow py-24 sm:py-32">
    <p class="eyebrow text-accent mb-4">404</p>
    <h1 class="display text-5xl sm:text-6xl">This page isn't here.</h1>
    <p class="mt-6 text-lg text-muted">The link may be old, or the page may have moved. Try one of these instead, or press <kbd class="font-mono text-sm px-1.5 py-0.5 rounded border border-line" data-kbd>Ctrl K</kbd> to search.</p>
    <ul class="mt-8 flex flex-wrap gap-3">
      {navLinks.map((l) => (
        <li><a href={l.href} class="btn">{l.label}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
