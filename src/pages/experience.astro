---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const experiences = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Experience - Aditya Gidh">
  <Header />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">Experience</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-12">10+ years building scalable web systems, leading engineering teams, and driving technical innovation.</p>
    </div>

    <div class="space-y-12">
      {experiences.map((exp) => (
        <article class="relative pl-8 border-l-2 border-gray-200 dark:border-gray-800">
          <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-primary-600 dark:bg-primary-400 border-2 border-white dark:border-gray-950"></div>
          <div class="mb-2">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white">{exp.data.title}</h2>
            <p class="text-primary-600 dark:text-primary-400 font-medium">{exp.data.company}</p>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">{exp.data.location} &middot; {exp.data.startDate} – {exp.data.endDate}</p>
          </div>
          <ul class="mt-4 space-y-2">
            {exp.data.highlights.map((highlight: string) => (
              <li class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed flex gap-2">
                <span class="text-primary-500 mt-1.5 flex-shrink-0">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                </span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <!-- Education -->
    <section class="mt-20 pt-12 border-t border-gray-200 dark:border-gray-800">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">Education</h2>
      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white">Master of Science in Information Systems</h3>
            <p class="text-gray-600 dark:text-gray-400">Northeastern University, Boston, MA</p>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 sm:mt-0">July 2015</p>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white">Bachelor of Engineering in Information Technology</h3>
            <p class="text-gray-600 dark:text-gray-400">Mumbai University, Mumbai, India</p>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 sm:mt-0">June 2013</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
