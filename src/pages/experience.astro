---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getCollection } from 'astro:content';

const experiences = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

const education = [
  { degree: 'Master of Science in Information Systems', school: 'Northeastern University, Boston, MA', date: 'July 2015' },
  { degree: 'Bachelor of Engineering in Information Technology', school: 'Mumbai University, Mumbai, India', date: 'June 2013' },
];
---

<BaseLayout title="Experience - Aditya Gidh">
  <div class="wrap pb-8">
    <PageHeader
      eyebrow="Experience"
      title="Where I've built things"
      lead="10+ years building scalable web systems, leading engineering teams, and driving technical innovation."
    />

    <ol class="relative ml-2 border-l border-line space-y-14">
      {experiences.map((exp) => (
        <li class="reveal relative pl-8 sm:pl-10">
          <span class="absolute -left-[5px] top-2 w-[9px] h-[9px] rounded-full bg-accent ring-4 ring-bg" aria-hidden="true"></span>
          <p class="font-mono text-xs text-muted">{exp.data.startDate} – {exp.data.endDate}</p>
          <h2 class="mt-1 font-serif text-2xl tracking-tight">{exp.data.title}</h2>
          <p class="mt-1 text-accent font-medium">{exp.data.company}</p>
          <p class="text-sm text-muted">{exp.data.location}</p>
          <ul class="mt-5 space-y-3">
            {exp.data.highlights.map((highlight: string) => (
              <li class="flex gap-3 text-sm text-muted leading-relaxed">
                <span class="mt-2 w-1 h-1 rounded-full bg-muted shrink-0" aria-hidden="true"></span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    <section class="mt-24 pt-14 border-t border-line">
      <SectionHeading label="Education" title="Education" />
      <ul class="divide-y divide-line border-y border-line">
        {education.map((e) => (
          <li class="reveal py-5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <div>
              <h3 class="font-medium">{e.degree}</h3>
              <p class="text-sm text-muted">{e.school}</p>
            </div>
            <p class="font-mono text-xs text-muted">{e.date}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
