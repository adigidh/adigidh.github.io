---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const talks = (await getCollection('talks')).sort((a, b) => b.data.year - a.data.year);

const typeBadge: Record<string, string> = {
  talk: 'badge-amber',
  poster: 'badge-teal',
  presentation: 'badge-indigo',
};
---

<BaseLayout title="Talks & Presentations - Aditya Gidh">
  <div class="wrap-narrow pb-8">
    <PageHeader
      eyebrow="Talks"
      title="Talks & presentations"
      lead="Conference talks, poster sessions, and professional presentations on AI, APIs, and modern development practices."
    />

    <ul class="space-y-5">
      {talks.map((talk) => (
        <li class="reveal">
          <article class="card card-hover p-6 sm:p-7">
            <div class="flex items-center gap-3 mb-3">
              <span class:list={['badge', typeBadge[talk.data.type]]}>{talk.data.type}</span>
              <span class="font-mono text-xs text-muted">{talk.data.year}</span>
            </div>
            <h2 class="font-serif text-2xl tracking-tight mb-1.5">{talk.data.title}</h2>
            {talk.data.url ? (
              <a href={talk.data.url} target="_blank" rel="noopener noreferrer" class="text-sm text-accent font-medium mb-3 inline-block prose-link">
                {talk.data.event}<span class="sr-only"> (opens in a new tab)</span>
              </a>
            ) : (
              <p class="text-sm text-accent font-medium mb-3">{talk.data.event}</p>
            )}
            <p class="text-sm text-muted leading-relaxed max-w-[54ch]">{talk.data.description}</p>
          </article>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
