---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import profile from '../assets/profile.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Aditya Gidh - Software Development Engineer | AI Engineering | DevOps | 10+ years building scalable systems" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: profile, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpeg' });
const ogURL = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function stored() {
          try {
            var t = localStorage.getItem('theme');
            return t === 'light' || t === 'dark' ? t : 'system';
          } catch (e) {
            return 'system';
          }
        }
        function apply() {
          var pref = stored();
          var dark = pref === 'dark' || (pref === 'system' && mq.matches);
          var root = document.documentElement;
          root.classList.toggle('dark', dark);
          root.classList.add('js');
          root.dataset.theme = pref;
        }
        window.__theme = {
          get: stored,
          set: function (pref) {
            try {
              if (pref === 'system') localStorage.removeItem('theme');
              else localStorage.setItem('theme', pref);
            } catch (e) {}
            apply();
          },
        };
        apply();
        mq.addEventListener('change', apply);
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-full focus:bg-fg focus:text-bg focus:text-sm"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
