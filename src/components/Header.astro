---
import { navLinks, site } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="sticky top-0 z-50 bg-bg/80 backdrop-blur-md border-b border-line">
  <nav class="wrap h-16 flex items-center justify-between gap-4" aria-label="Primary">
    <a href="/" class="flex items-center gap-2.5 group" aria-label={`${site.name} - home`}>
      <span class="grid place-items-center w-8 h-8 rounded-full bg-fg text-bg font-serif text-sm font-semibold group-hover:bg-accent group-hover:text-accent-fg transition-colors">AG</span>
      <span class="hidden sm:block font-serif text-lg tracking-tight">{site.name}</span>
    </a>

    <ul class="hidden md:flex items-center gap-1">
      {navLinks.filter((l) => l.href !== '/').map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'relative px-3 py-2 text-sm transition-colors',
              "after:content-[''] after:absolute after:left-3 after:right-3 after:-bottom-px after:h-px after:bg-accent after:origin-left after:transition-transform after:duration-200",
              isActive(href)
                ? 'text-fg font-medium after:scale-x-100'
                : 'text-muted hover:text-fg after:scale-x-0 hover:after:scale-x-100',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        data-palette-open
        aria-label="Open command palette"
        aria-keyshortcuts="Control+K Meta+K"
        class="hidden sm:inline-flex items-center gap-2 h-9 pl-3 pr-2 rounded-full border border-line bg-surface text-muted hover:text-fg hover:border-fg transition-colors text-sm"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" /></svg>
        <span>Search</span>
        <kbd class="font-mono text-[0.65rem] px-1.5 py-0.5 rounded border border-line text-muted" data-kbd>Ctrl K</kbd>
      </button>
      <button
        type="button"
        data-palette-open
        aria-label="Open command palette"
        class="sm:hidden grid place-items-center w-11 h-11 rounded-full text-muted hover:text-fg hover:bg-surface transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" /></svg>
      </button>

      <button
        type="button"
        data-theme-toggle
        aria-label="Switch to dark theme"
        title="Toggle light / dark theme"
        class="grid place-items-center w-11 h-11 sm:w-9 sm:h-9 rounded-full text-muted hover:text-fg hover:bg-surface transition-colors"
      >
        <svg class="theme-icon theme-icon-light w-[1.15rem] h-[1.15rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
        <svg class="theme-icon theme-icon-dark w-[1.15rem] h-[1.15rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
      </button>

      <button
        type="button"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden grid place-items-center w-11 h-11 rounded-full text-muted hover:text-fg hover:bg-surface transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" hidden class="md:hidden fixed inset-x-0 top-16 bottom-0 bg-bg border-t border-line overflow-y-auto">
    <ul class="wrap py-4">
      {navLinks.map(({ href, label }, i) => (
        <li class="border-b border-line last:border-0">
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between min-h-14 font-serif text-2xl',
              isActive(href) ? 'text-accent' : 'text-fg',
            ]}
          >
            <span>{label}</span>
            <span class="font-mono text-xs text-muted">0{i + 1}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
