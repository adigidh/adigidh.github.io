---
import { stats } from '../data/site';
---

<dl class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-line border border-line rounded-2xl overflow-hidden">
  {stats.map((s, i) => (
    <div class="reveal bg-surface min-w-0 p-5 sm:p-6" style={`--reveal-delay:${i * 70}ms`}>
      <dt class="sr-only">{s.label}</dt>
      <dd class="font-serif text-3xl min-[420px]:text-4xl sm:text-5xl tracking-tight text-fg break-words">{s.value}</dd>
      <p class="mt-2 text-xs sm:text-sm text-muted leading-normal break-words" aria-hidden="true">{s.label}</p>
    </div>
  ))}
</dl>
