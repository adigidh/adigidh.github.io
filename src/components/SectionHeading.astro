---
interface Props {
  index?: string;
  label: string;
  title?: string;
  href?: string;
  linkLabel?: string;
}

const { index, label, title, href, linkLabel } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2 mb-8">
  <div>
    <p class="eyebrow mb-2">{index && <span class="text-accent mr-2">{index}</span>}{label}</p>
    {title && <h2 class="font-serif text-3xl sm:text-4xl tracking-tight">{title}</h2>}
  </div>
  {href && (
    <a href={href} class="shrink-0 text-sm text-muted hover:text-accent transition-colors py-2">
      {linkLabel ?? 'View all'} &rarr;
    </a>
  )}
</div>
