---
import { getCollection } from 'astro:content';
import { navLinks, site } from '../data/site';

interface Item {
  group: string;
  label: string;
  hint?: string;
  href?: string;
  action?: 'copy-email' | 'toggle-theme' | 'system-theme';
  external?: boolean;
}

const [projects, publications, talks] = await Promise.all([
  getCollection('projects'),
  getCollection('publications'),
  getCollection('talks'),
]);

const items: Item[] = [
  ...navLinks.map((l) => ({ group: 'Pages', label: l.label, href: l.href })),
  ...projects
    .sort((a, b) => a.data.order - b.data.order)
    .map((p) => ({ group: 'Projects', label: p.data.title, href: `/projects#${p.id}` })),
  ...publications
    .sort((a, b) => b.data.year - a.data.year)
    .map((p) => ({ group: 'Publications', label: p.data.title, hint: `${p.data.year}`, href: p.data.url ?? '/publications', external: !!p.data.url })),
  ...talks
    .sort((a, b) => b.data.year - a.data.year)
    .map((t) => ({ group: 'Talks', label: t.data.title, hint: `${t.data.year}`, href: '/talks' })),
  { group: 'Links', label: 'LinkedIn', href: site.socials.linkedin, external: true },
  { group: 'Links', label: 'GitHub', href: site.socials.github, external: true },
  { group: 'Actions', label: 'Copy email address', hint: site.email, action: 'copy-email' },
  { group: 'Actions', label: 'Switch between light and dark theme', action: 'toggle-theme' },
  { group: 'Actions', label: 'Use system theme', hint: 'follow OS setting', action: 'system-theme' },
];

const groups = [...new Set(items.map((i) => i.group))];
let n = 0;
---

<dialog class="palette" aria-label="Command palette" data-palette>
  <div class="flex items-center gap-3 px-4 border-b border-line">
    <svg class="w-4 h-4 text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" /></svg>
    <input
      type="text"
      data-palette-input
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      aria-label="Search pages, projects, publications and talks"
      placeholder="Search pages, projects, publications..."
      autocomplete="off"
      spellcheck="false"
      class="flex-1 h-14 bg-transparent text-base placeholder:text-muted focus:outline-none"
    />
    <kbd class="font-mono text-[0.65rem] px-1.5 py-0.5 rounded border border-line text-muted">Esc</kbd>
  </div>

  <div id="palette-list" role="listbox" aria-label="Results" class="overflow-y-auto max-h-[calc(70vh-3.5rem-2.5rem)] py-2">
    {groups.map((group) => (
      <div data-palette-group>
        <p class="eyebrow px-4 pt-3 pb-1.5" aria-hidden="true">{group}</p>
        {items.filter((i) => i.group === group).map((item) => {
          const id = `palette-opt-${n++}`;
          const common = {
            id,
            role: 'option',
            'aria-selected': 'false',
            'data-palette-item': '',
            'data-search': `${item.group} ${item.label} ${item.hint ?? ''}`.toLowerCase(),
            class: 'flex items-center justify-between gap-4 px-4 min-h-11 py-2 text-sm text-left w-full aria-selected:bg-accent-soft aria-selected:text-fg text-muted hover:text-fg',
          };
          return item.href ? (
            <a {...common} href={item.href} {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <span class="truncate text-fg">{item.label}</span>
              <span class="flex items-center gap-2 shrink-0 font-mono text-xs">
                {item.hint}
                {item.external && <span aria-hidden="true">&nearr;</span>}
              </span>
            </a>
          ) : (
            <button {...common} type="button" data-action={item.action}>
              <span class="truncate text-fg">{item.label}</span>
              <span class="shrink-0 font-mono text-xs">{item.hint}</span>
            </button>
          );
        })}
      </div>
    ))}
    <p data-palette-empty hidden class="px-4 py-8 text-center text-sm text-muted">No matches.</p>
  </div>

  <div class="flex items-center gap-4 px-4 h-10 border-t border-line font-mono text-[0.65rem] text-muted">
    <span><kbd>&uarr;&darr;</kbd> navigate</span>
    <span><kbd>&crarr;</kbd> open</span>
    <span class="ml-auto"><kbd>Esc</kbd> close</span>
  </div>
</dialog>
